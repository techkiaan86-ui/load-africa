model DriverCompliance {
  id                String   @id @default(uuid())
  driver_id         String
  uniform_standards Boolean  @default(false)
  hygiene           Boolean  @default(false)
  documentation     Boolean  @default(false)
  last_updated      DateTime @default(now())

  driver Driver @relation(fields: [driver_id], references: [id], onDelete: Cascade)
}

model TripPerformance {
  id                      String    @id @default(uuid())
  booking_id              String    @unique
  driver_id               String
  dot_status              String?
  arrive_time             DateTime?
  collection_time         DateTime?
  depart_time             DateTime?
  destination_arrive_time DateTime?
  weight_of_load          Decimal?  @db.Decimal(10, 2)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driver_id], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

enum PayoutStatus {
  EXPECTED
  PENDING_PAYOUT
  PAYOUT_PROCESSING
  PAID
  PAYOUT_FAILED
}

model BookingSettlement {
  id                         String       @id @default(uuid())
  booking_id                 String       @unique
  customerPaymentAmount      Decimal      @default(0.00) @db.Decimal(10, 2)
  platformFee                Decimal      @default(0.00) @db.Decimal(10, 2)
  fleetOwnerExpectedEarnings Decimal      @default(0.00) @db.Decimal(10, 2)
  driverExpectedEarnings     Decimal      @default(0.00) @db.Decimal(10, 2)
  fleetOwnerPayoutStatus     PayoutStatus @default(EXPECTED)
  driverPayoutStatus         PayoutStatus @default(EXPECTED)
  fleetOwnerPayoutReference  String?
  driverPayoutReference      String?
  created_at                 DateTime     @default(now())
  updated_at                 DateTime     @updatedAt

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@map("booking_settlements")
}
